{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Lepidox",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/AdrielGTeles/lepidox",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitleInactive__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/lepidox-inactive-16.png",
      "32": "assets/icons/lepidox-inactive-32.png",
      "48": "assets/icons/lepidox-inactive-48.png",
      "128": "assets/icons/lepidox-inactive-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/lepidox-16.png",
    "32": "assets/icons/lepidox-32.png",
    "48": "assets/icons/lepidox-48.png",
    "128": "assets/icons/lepidox-128.png"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": { "default": "Alt+Shift+Space" },
      "description": "__MSG_cmdTogglePause__"
    },
    "next-screen": {
      "suggested_key": { "default": "Alt+Shift+Right" },
      "description": "__MSG_cmdNext__"
    },
    "previous-screen": {
      "suggested_key": { "default": "Alt+Shift+Left" },
      "description": "__MSG_cmdPrevious__"
    },
    "stop-rotation": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdStop__"
    }
  }
}
